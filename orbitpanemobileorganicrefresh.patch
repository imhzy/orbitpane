index 0000000..55ac4a5
--- /dev/null
+++ b/frontend/src/components/PreferencesSheet.tsx
@@ -0,0 +1,148 @@
+import { useEffect, useState } from 'react'
+import { motion, AnimatePresence } from 'framer-motion'
+import { Moon, Sun, Check } from 'lucide-react'
+import { isHapticsEnabled, setHapticsEnabled, haptic } from '../lib/nativeFeedback'
+import { useAppContext } from '../contexts/AppContext'
+
+interface PreferencesSheetProps {
+  isOpen: boolean
+  onClose: () => void
+}
+
+/**
+ * Mobile "偏好" surface: theme, model, and notification/feedback settings in
+ * one place, following the same bottom-sheet idiom the app already uses for
+ * the command palette and model/message action pickers.
+ */
+export function PreferencesSheet({ isOpen, onClose }: PreferencesSheetProps) {
+  const { theme, toggleTheme, models, selectedModel, setSelectedModel, formatModelName, providers, defaultProvider } = useAppContext()
+  const [notificationsEnabled, setNotificationsEnabled] = useState(() => (
+    typeof Notification !== 'undefined' && Notification.permission === 'granted'
+  ))
+  const [hapticsEnabled, setHapticsOn] = useState(() => isHapticsEnabled())
+
+  useEffect(() => {
+    if (isOpen) document.body.style.overflow = 'hidden'
+    return () => { document.body.style.overflow = '' }
+  }, [isOpen])
+
+  const requestNotifications = async () => {
+    if (typeof Notification === 'undefined') return
+    if (Notification.permission === 'granted') return
+    const permission = await Notification.requestPermission()
+    setNotificationsEnabled(permission === 'granted')
+  }
+
+  const providerLabel = (modelId: string) => {
+    const provider = providers.find(p => p.models?.includes(modelId))
+    const name = provider?.name || defaultProvider || '默认服务商'
+    return modelId === selectedModel ? `${name} · 默认` : name
+  }
+
+  if (!isOpen) return null
+
+  return (
+    <AnimatePresence>
+      <motion.button
+        type="button"
+        className="mobile-sheet-backdrop prefs-sheet-backdrop"
+        aria-label="关闭偏好设置"
+        initial={{ opacity: 0 }}
+        animate={{ opacity: 1 }}
+        exit={{ opacity: 0 }}
+        onClick={onClose}
+      />
+      <motion.div
+        className="mobile-bottom-sheet prefs-sheet"
+        role="dialog"
+        aria-label="偏好设置"
+        drag="y"
+        dragDirectionLock={true}
+        dragConstraints={{ top: 0, bottom: 800 }}
+        dragElastic={0.08}
+        dragMomentum={false}
+        onDragEnd={(_event, info) => {
+          if (info.offset.y > 90 || info.velocity.y > 500) onClose()
+        }}
+        initial={{ y: 800 }}
+        animate={{ y: 0 }}
+        exit={{ y: 800 }}
+        transition={{ type: 'spring', damping: 28, stiffness: 320 }}
+      >
+        <div className="mobile-sheet-grabber" aria-hidden="true" />
+        <div className="mobile-sheet-title prefs-sheet-title">偏好</div>
+
+        <div className="prefs-section">
+          <div className="prefs-section-label">主题</div>
+          <div className="prefs-theme-toggle">
+            <button
+              type="button"
+              className={theme === 'dark' ? 'active' : ''}
+              onClick={() => { if (theme !== 'dark') { toggleTheme(); haptic('selection') } }}
+            ><Moon size={15} />暗夜</button>
+            <button
+              type="button"
+              className={theme === 'light' ? 'active' : ''}
+              onClick={() => { if (theme !== 'light') { toggleTheme(); haptic('selection') } }}
+            ><Sun size={15} />明亮</button>
+          </div>
+        </div>
+
+        {models.length > 0 && (
+          <div className="prefs-section">
+            <div className="prefs-section-label">选择运行模型</div>
+            <div className="prefs-model-list">
+              {models.map(m => (
+                <button
+                  type="button"
+                  key={m}
+                  className={`prefs-model-item ${selectedModel === m ? 'selected' : ''}`}
+                  onClick={() => { setSelectedModel(m); haptic('selection') }}
+                >
+                  <span className="prefs-model-check">{selectedModel === m && <Check size={16} />}</span>
+                  <span className="prefs-model-copy">
+                    <span className="prefs-model-name">{formatModelName(m)}</span>
+                    <span className="prefs-model-provider">{providerLabel(m)}</span>
+                  </span>
+                </button>
+              ))}
+            </div>
+          </div>
+        )}
+
+        <div className="prefs-section">
+          <div className="prefs-section-label">通知与反馈</div>
+          <div className="prefs-toggle-list">
+            <button
+              type="button"
+              className="prefs-toggle-row"
+              onClick={() => void requestNotifications()}
+            >
+              <span className="prefs-toggle-copy">
+                <span className="prefs-toggle-label">任务完成通知</span>
+                <span className="prefs-toggle-hint">任务结束或需要你拍板时推送系统通知</span>
+              </span>
+              <span className={`prefs-switch ${notificationsEnabled ? 'on' : ''}`} />
+            </button>
+            <button
+              type="button"
+              className="prefs-toggle-row"
+              onClick={() => {
+                const next = !hapticsEnabled
+                setHapticsOn(next)
+                setHapticsEnabled(next)
+                if (next) haptic('success')
+              }}
+            >
+              <span className="prefs-toggle-copy">
+                <span className="prefs-toggle-label">触感与音效反馈</span>
+                <span className="prefs-toggle-hint">发送、长按、中断时的震动与提示音</span>
+              </span>
+              <span className={`prefs-switch ${hapticsEnabled ? 'on' : ''}`} />
+            </button>
+          </div>
+        </div>
+      </motion.div>
+    </AnimatePresence>
+  )
+}
