@@ -7,9 +7,22 @@ const PATTERNS: Record<HapticKind, number | number[]> = {
   warning: [30, 45, 30],
 }
 
+const HAPTICS_STORAGE_KEY = 'orbitpane_haptics_enabled'
+
+export function isHapticsEnabled(): boolean {
+  if (typeof localStorage === 'undefined') return true
+  return localStorage.getItem(HAPTICS_STORAGE_KEY) !== 'off'
+}
+
+export function setHapticsEnabled(enabled: boolean) {
+  if (typeof localStorage === 'undefined') return
+  localStorage.setItem(HAPTICS_STORAGE_KEY, enabled ? 'on' : 'off')
+}
+
 export function haptic(kind: HapticKind = 'selection') {
   if (typeof navigator === 'undefined' || !navigator.vibrate) return
   if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return
+  if (!isHapticsEnabled()) return
   navigator.vibrate(PATTERNS[kind])
 }
 
