@@ -0,0 +1,97 @@
+import { useCallback, useEffect, useMemo, useState } from 'react'
+import { ChevronUp } from 'lucide-react'
+import { apiFetch } from '../lib/api'
+import { haptic } from '../lib/nativeFeedback'
+import type { Conversation, ConversationStats, TaskRecord } from '../lib/types'
+
+const EMPTY_STATS: ConversationStats = {
+  message_count: 0,
+  duration: 0,
+  input_chars: 0,
+  output_chars: 0,
+  context_chars: 0,
+  summary_count: 0,
+  context_limit: 120_000,
+}
+
+/**
+ * Compact mobile-only capsule shown between the header and the message list:
+ * "N 个执行中 · N 个排队 · 上下文 N%". Tapping it opens the same full-screen
+ * WorkspaceInspector the header's task badge opens. Desktop keeps the
+ * always-visible inspector side panel, so this renders nothing there.
+ */
+export function TaskCapsule({ activeConv }: { activeConv: Conversation | null }) {
+  const [tasks, setTasks] = useState<TaskRecord[]>([])
+  const [stats, setStats] = useState<ConversationStats>(EMPTY_STATS)
+  const conversationId = activeConv?.id ?? null
+
+  const load = useCallback(async () => {
+    if (!conversationId) {
+      setTasks([])
+      return
+    }
+    try {
+      const [taskResponse, nextStats] = await Promise.all([
+        apiFetch<{ items: TaskRecord[] }>(`/api/conversations/${conversationId}/tasks`),
+        apiFetch<ConversationStats>(`/api/conversations/${conversationId}/stats`),
+      ])
+      setTasks(taskResponse.items)
+      setStats(nextStats)
+    } catch {
+      // Silent: this is a glanceable summary, the inspector panel is the source of truth.
+    }
+  }, [conversationId])
+
+  useEffect(() => {
+    setTasks([])
+    setStats(EMPTY_STATS)
+    void load()
+  }, [conversationId, load])
+
+  useEffect(() => {
+    const refresh = () => void load()
+    window.addEventListener('orbitpane-task-change', refresh)
+    const timer = window.setInterval(refresh, 5_000)
+    return () => {
+      window.removeEventListener('orbitpane-task-change', refresh)
+      window.clearInterval(timer)
+    }
+  }, [load])
+
+  const runningCount = useMemo(
+    () => tasks.filter(t => t.status === 'running' || t.status === 'starting').length,
+    [tasks],
+  )
+  const queuedCount = useMemo(() => tasks.filter(t => t.status === 'queued').length, [tasks])
+  const contextPercent = Math.min(
+    100,
+    Math.round((stats.context_chars / Math.max(1, stats.context_limit || 120_000)) * 100),
+  )
+
+  if (!activeConv || (runningCount === 0 && queuedCount === 0)) return null
+
+  const parts = [
+    runningCount > 0 ? `${runningCount} 个执行中` : null,
+    queuedCount > 0 ? `${queuedCount} 个排队` : null,
+    `上下文 ${contextPercent}%`,
+  ].filter(Boolean)
+
+  return (
+    <button
+      type="button"
+      className="mobile-only-action task-capsule"
+      onClick={() => {
+        haptic('selection')
+        const url = new URL(window.location.href)
+        url.searchParams.set('panel', 'tasks')
+        window.history.pushState({ ...window.history.state, orbitpanePanel: 'tasks' }, '', url.toString())
+        window.dispatchEvent(new CustomEvent('orbitpane-open-inspector', { detail: 'tasks' }))
+      }}
+      aria-label="打开任务与上下文"
+    >
+      <span className="task-capsule-dot" aria-hidden="true" />
+      <span className="task-capsule-label">{parts.join(' · ')}</span>
+      <span className="task-capsule-open" aria-hidden="true"><ChevronUp size={15} /></span>
+    </button>
+  )
+}
