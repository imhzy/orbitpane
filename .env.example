# Copy to .env (gitignored) and fill in. The backend reads .env from the repo
# root at startup; real environment variables always take precedence over it.

# Runtime
ORBITPANE_ENV=production
ORBITPANE_HOST=127.0.0.1
ORBITPANE_PORT=8005
ORBITPANE_DATABASE_PATH=/path/to/orbitpane/history.db
# Comma separated. The first entry is the default root in the project browser.
ORBITPANE_ALLOWED_ROOTS=/srv/workspaces,/root/projects
ORBITPANE_CORS_ORIGINS=

# Authentication: generate a long random secret, for example with `openssl rand -hex 32`.
# Production refuses to start unless both of these are set. The secret also
# seals stored share tokens: rotating it signs everyone out and leaves existing
# share links working but no longer listable with their address.
ORBITPANE_PIN=change-me
ORBITPANE_AUTH_SECRET=change-me-to-a-long-random-secret
ORBITPANE_AUTH_TTL_SECONDS=43200

# Antigravity provider
ORBITPANE_DEFAULT_PROVIDER=antigravity
ORBITPANE_HISTORY_MAX_CHARS=120000
ORBITPANE_ANTIGRAVITY_COMMAND=antigravity
# Leave empty to discover models (and their display names) from `<command> models`;
# set a CSV list to pin specific model ids instead.
ORBITPANE_ANTIGRAVITY_MODELS=
ORBITPANE_ANTIGRAVITY_PROXY_URL=

# Optional Codex provider. It uses `codex exec --json` with an explicit sandbox.
CODEX_ENABLED=false
CODEX_COMMAND=codex
# Leave empty to discover models from `codex debug models`; set a CSV list to override it.
CODEX_MODELS=
CODEX_SANDBOX=workspace-write
