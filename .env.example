# Runtime
ORBITPANE_ENV=production
ORBITPANE_HOST=127.0.0.1
ORBITPANE_PORT=8005
ORBITPANE_DATABASE_PATH=/path/to/orbitpane/history.db
ORBITPANE_ALLOWED_ROOTS=/srv/workspaces,/root/projects
ORBITPANE_CORS_ORIGINS=

# Authentication: generate a long random secret, for example with `openssl rand -hex 32`.
ORBITPANE_PIN=change-me
ORBITPANE_AUTH_SECRET=change-me-to-a-long-random-secret
ORBITPANE_AUTH_TTL_SECONDS=43200

# Antigravity provider
ORBITPANE_DEFAULT_PROVIDER=antigravity
ORBITPANE_HISTORY_MAX_CHARS=120000
ORBITPANE_ANTIGRAVITY_COMMAND=antigravity
ORBITPANE_ANTIGRAVITY_MODELS=gemini-3.6-flash-high,gemini-3.1-pro-high
ORBITPANE_ANTIGRAVITY_PROXY_URL=
# This disables agent permission prompts and should only be enabled in an isolated environment.
ORBITPANE_ANTIGRAVITY_DANGEROUS_SKIP_PERMISSIONS=false

# Optional Codex provider. It uses `codex exec --json` with an explicit sandbox.
CODEX_ENABLED=false
CODEX_COMMAND=codex
CODEX_MODELS=
CODEX_SANDBOX=workspace-write
