# Runtime
AGY_ENV=production
AGY_HOST=127.0.0.1
AGY_PORT=8005
AGY_DATABASE_PATH=/root/agy_web_bridge/history.db
AGY_ALLOWED_ROOTS=/root/agy_web_bridge
AGY_CORS_ORIGINS=

# Authentication: generate a long random secret, for example with `openssl rand -hex 32`.
AGY_PIN=change-me
AGY_AUTH_SECRET=change-me-to-a-long-random-secret
AGY_AUTH_TTL_SECONDS=43200

# Antigravity provider
AGY_DEFAULT_PROVIDER=agy
AGY_COMMAND=agy
AGY_MODELS=gemini-3.6-flash-high,gemini-3.1-pro-high
AGY_HISTORY_MAX_CHARS=120000
AGY_PROXY_URL=
# This disables agent permission prompts and should only be enabled in an isolated environment.
AGY_DANGEROUS_SKIP_PERMISSIONS=false

# Optional Codex provider. It uses `codex exec --json` with an explicit sandbox.
CODEX_ENABLED=false
CODEX_COMMAND=codex
CODEX_MODELS=
CODEX_SANDBOX=workspace-write
